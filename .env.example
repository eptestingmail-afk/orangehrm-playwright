# Is file ko copy karke `.env` banao (sirf local ke liye). `.env` git mein ignore hai.
# CI mein ye values GitHub Secrets / Variables se aati hain, .env ki zaroorat nahi.

# --- Non-secret (CI mein GitHub "Variables") ---
BASE_URL=https://opensource-demo.orangehrmlive.com

# --- SECRET (CI mein GitHub "Secrets"; kabhi commit nahi) ---
# OrangeHRM public demo ke credentials us site ke login page par hi likhe hote hain:
#   username: Admin   password: admin123
# Apni company ke project mein hamesha alag TEST account use karo.
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123
